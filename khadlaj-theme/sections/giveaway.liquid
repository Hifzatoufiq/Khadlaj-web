      <!-- Luxury National Day Giveaway Form (Exact Match to Target Design) -->
      <div class="knd-luxury-form-card">
        <h3 class="knd-form-main-heading">PARTICIPATE IN THE NATIONAL DAY GIVEAWAY</h3>
        <p class="knd-form-main-desc">Enter your details below to submit your official entry into the National Day draw.</p>

        <form id="knd-giveaway-form-{{ section.id }}" class="knd-form-body" onsubmit="handleKndGiveawaySubmit(event, '{{ section.id }}')">
          
          <!-- 1. Full Name -->
          <div class="knd-field-group">
            <label class="knd-field-label" for="knd-full-name-{{ section.id }}">FULL NAME *</label>
            <div class="knd-input-wrap knd-icon-user">
              <input type="text" id="knd-full-name-{{ section.id }}" name="name" class="knd-input" placeholder="e.g. Faisal Al-Otaibi" required>
            </div>
          </div>

          <!-- 2. Email Address -->
          <div class="knd-field-group">
            <label class="knd-field-label" for="knd-email-{{ section.id }}">EMAIL ADDRESS *</label>
            <div class="knd-input-wrap knd-icon-email">
              <input type="email" id="knd-email-{{ section.id }}" name="email" class="knd-input" placeholder="name@example.com" required>
            </div>
          </div>

          <!-- 3. Phone / WhatsApp (Side-by-Side Split Row) -->
          <div class="knd-field-group">
            <label class="knd-field-label">PHONE / WHATSAPP *</label>
            <div class="knd-phone-split-row">
              <div class="knd-country-box">
                <span class="knd-flag-icon">🇸🇦</span>
                <span class="knd-country-text" id="knd-country-display-{{ section.id }}">+966 (KSA)</span>
                <svg class="knd-arrow-icon" viewBox="0 0 24 24" width="16" height="16"><path fill="#251737" d="M7 10l5 5 5-5z"/></svg>
                <select id="knd-country-code-{{ section.id }}" class="knd-hidden-select" onchange="var opt = this.options[this.selectedIndex]; document.getElementById('knd-country-display-{{ section.id }}').textContent = opt.getAttribute('data-short'); document.querySelector('#shopify-section-{{ section.id }} .knd-flag-icon').textContent = opt.getAttribute('data-flag');">
                  <option value="+966" data-flag="🇸🇦" data-short="+966 (KSA)" selected>Saudi Arabia (+966)</option>
                  <option value="+971" data-flag="🇦🇪" data-short="+971 (UAE)">United Arab Emirates (+971)</option>
                  <option value="+965" data-flag="🇰🇼" data-short="+965 (KWT)">Kuwait (+965)</option>
                  <option value="+973" data-flag="🇧🇭" data-short="+973 (BHR)">Bahrain (+973)</option>
                  <option value="+968" data-flag="🇴🇲" data-short="+968 (OMN)">Oman (+968)</option>
                  <option value="+974" data-flag="🇶🇦" data-short="+974 (QAT)">Qatar (+974)</option>
                </select>
              </div>
              <div class="knd-phone-input-wrap">
                <input type="tel" id="knd-phone-{{ section.id }}" name="phone" class="knd-input knd-phone-input" placeholder="50 123 4567" required>
              </div>
            </div>
          </div>

          <!-- 4. Instagram Username -->
          <div class="knd-field-group">
            <label class="knd-field-label" for="knd-instagram-{{ section.id }}">INSTAGRAM USERNAME *</label>
            <div class="knd-input-wrap knd-icon-instagram">
              <input type="text" id="knd-instagram-{{ section.id }}" name="instagram" class="knd-input" placeholder="e.g. @username" required>
            </div>
          </div>

          <!-- 5. City in Saudi Arabia -->
          <div class="knd-field-group">
            <label class="knd-field-label" for="knd-city-{{ section.id }}">CITY IN SAUDI ARABIA (KSA ONLY) *</label>
            <div class="knd-select-wrap">
              <select id="knd-city-{{ section.id }}" name="city" class="knd-select" required>
                <option value="Riyadh (الرياض)" selected>Riyadh (الرياض)</option>
                <option value="Jeddah (جدة)">Jeddah (جدة)</option>
                <option value="Makkah (مكة المكرمة)">Makkah (مكة المكرمة)</option>
                <option value="Madinah (المدينة المنورة)">Madinah (المدينة المنورة)</option>
                <option value="Dammam (الدمام)">Dammam (الدمام)</option>
                <option value="Khobar (الخبر)">Khobar (الخبر)</option>
                <option value="Dhahran (الظهران)">Dhahran (الظهران)</option>
                <option value="Tabuk (تبوك)">Tabuk (تبوك)</option>
                <option value="Buraidah (بريدة)">Buraidah (بريدة)</option>
                <option value="Taif (الطائف)">Taif (الطائف)</option>
                <option value="Abha (أبها)">Abha (أبها)</option>
                <option value="Khamis Mushait (خميس مشيط)">Khamis Mushait (خميس مشيط)</option>
                <option value="Jazan (جازان)">Jazan (جازان)</option>
                <option value="Najran (نجran)">Najran (نجران)</option>
                <option value="Al Ahsa (الأحساء)">Al Ahsa (الأحساء)</option>
                <option value="Hail (حائل)">Hail (حائل)</option>
                <option value="Jubail (الجبيل)">Jubail (الجبيل)</option>
                <option value="Yanbu (ينبع)">Yanbu (ينبع)</option>
                <option value="Other KSA City">Other KSA City</option>
              </select>
              <svg class="knd-select-arrow" viewBox="0 0 24 24" width="20" height="20"><path fill="#251737" d="M7 10l5 5 5-5z"/></svg>
            </div>
          </div>

          <!-- 6. Delivery Address -->
          <div class="knd-field-group">
            <label class="knd-field-label" for="knd-address-{{ section.id }}">DELIVERY ADDRESS IN KSA (NATIONAL ADDRESS / STREET & DISTRICT) *</label>
            <div class="knd-input-wrap knd-icon-pin">
              <input type="text" id="knd-address-{{ section.id }}" name="address" class="knd-input" placeholder="e.g. Al Olaya Dist, King Fahd Rd, Building 4292" required>
            </div>
          </div>

          <!-- 7. Consent Checkbox -->
          <div class="knd-checkbox-row">
            <input type="checkbox" id="knd-consent-{{ section.id }}" class="knd-checkbox" required checked>
            <label for="knd-consent-{{ section.id }}" class="knd-checkbox-label">
              Yes, enter my name into the Saudi National Day Grand Giveaway draw and send my confirmation via WhatsApp / Email.
            </label>
          </div>

          <!-- 8. Submit Button -->
          <button type="submit" id="knd-submit-btn-{{ section.id }}" class="knd-submit-button">
            ENTER GIVEAWAY & PARTICIPATE NOW →
          </button>

          <!-- Result Message -->
          <div id="knd-result-{{ section.id }}" class="knd-result-box" style="display: none;"></div>

        </form>

        <!-- Hidden Hulk App Block Bridge (Preserves App Lead Logging) -->
        <div class="knd-hulk-bridge" style="position: absolute !important; left: -9999px !important; top: -9999px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; opacity: 0 !important; pointer-events: none !important;">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {% render block %}
            {%- endfor -%}
          {%- endif -%}
          <div class="pxFormGenerator" id="{% if section.settings.hulk_form_id != blank %}{{ section.settings.hulk_form_id }}{% else %}yEtzJaHyZSNuAnixqcgJAg{% endif %}"></div>
          {%- if section.settings.form_embed_code != blank -%}
            {{ section.settings.form_embed_code }}
          {%- endif -%}
        </div>


      </div>
    </div>

    <div
      class="ksnd-col ksnd-content-col"
      style="order: {% if section.settings.content_position == 'left' %}1{% else %}2{% endif %};"
      data-ksnd-countdown
      data-end-date="{{ section.settings.countdown_end_date }}"
    >
      <h2 class="ksnd-heading">
        {{ section.settings.heading_line_1 }}<br>{{ section.settings.heading_line_2 }}
        <span class="ksnd-highlight">{{ section.settings.highlight_text }}</span>
      </h2>

      {%- if section.settings.arabic_text != blank -%}
        <p class="ksnd-arabic">{{ section.settings.arabic_text }}</p>
      {%- endif -%}

      <div class="ksnd-description">{{ section.settings.description }}</div>

      <div class="ksnd-countdown">
        <p class="ksnd-countdown-label">{{ section.settings.countdown_icon }} {{ section.settings.countdown_label }}</p>
        <div class="ksnd-countdown-boxes">
          <div class="ksnd-countdown-box">
            <span class="ksnd-countdown-number" data-ksnd-days>00</span>
            <span class="ksnd-countdown-unit">Days</span>
          </div>
          <div class="ksnd-countdown-box">
            <span class="ksnd-countdown-number" data-ksnd-hours>00</span>
            <span class="ksnd-countdown-unit">Hours</span>
          </div>
          <div class="ksnd-countdown-box">
            <span class="ksnd-countdown-number" data-ksnd-minutes>00</span>
            <span class="ksnd-countdown-unit">Minutes</span>
          </div>
          <div class="ksnd-countdown-box">
            <span class="ksnd-countdown-number" data-ksnd-seconds>00</span>
            <span class="ksnd-countdown-unit">Seconds</span>
          </div>
        </div>
      </div>

      <div class="ksnd-prize">
        <div class="ksnd-prize-header">
          <p class="ksnd-prize-label">{{ section.settings.prize_label }}</p>
          <span class="ksnd-prize-badge">{{ section.settings.prize_badge_text }}</span>
        </div>
        <div class="ksnd-prize-body">
          <div class="ksnd-prize-image">
            {%- if section.settings.product_image != blank -%}
              <img src="{{ section.settings.product_image | image_url: width: 200 }}" alt="{{ section.settings.product_title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          <div>
            <p class="ksnd-prize-title">{{ section.settings.product_title }}</p>
            <p class="ksnd-prize-desc">{{ section.settings.product_description }}</p>
            <div class="ksnd-tags">
              {%- if section.settings.tag_1_text != blank -%}
                <span class="ksnd-tag">{{ section.settings.tag_1_text }}</span>
              {%- endif -%}
              {%- if section.settings.tag_2_text != blank -%}
                <span class="ksnd-tag">{{ section.settings.tag_2_text }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-ksnd-countdown]');
    if (!root) return;

    var endDateStr = root.getAttribute('data-end-date');
    var endDate = new Date(endDateStr).getTime();
    if (isNaN(endDate)) return;

    var daysEl = root.querySelector('[data-ksnd-days]');
    var hoursEl = root.querySelector('[data-ksnd-hours]');
    var minutesEl = root.querySelector('[data-ksnd-minutes]');
    var secondsEl = root.querySelector('[data-ksnd-seconds]');

    function pad(n) {
      return String(n).length < 2 ? '0' + n : String(n);
    }

    function tick() {
      var now = new Date().getTime();
      var diff = endDate - now;

      if (diff <= 0) {
        daysEl.textContent = '00';
        hoursEl.textContent = '00';
        minutesEl.textContent = '00';
        secondsEl.textContent = '00';
        clearInterval(timer);
        return;
      }

      var d = Math.floor(diff / (1000 * 60 * 60 * 24));
      var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var s = Math.floor((diff % (1000 * 60)) / 1000);

      daysEl.textContent = pad(d);
      hoursEl.textContent = pad(h);
      minutesEl.textContent = pad(m);
      secondsEl.textContent = pad(s);
    }

    tick();
    var timer = setInterval(tick, 1000);
  })();

  function handleKndGiveawaySubmit(e, sectionId) {
    e.preventDefault();
    var form = document.getElementById('knd-giveaway-form-' + sectionId);
    var btn = document.getElementById('knd-submit-btn-' + sectionId);
    var resultBox = document.getElementById('knd-result-' + sectionId);
    if (!form || !btn) return;

    // Clear previous errors
    var existingErrors = form.querySelectorAll('.knd-field-error-msg');
    existingErrors.forEach(function(el) { el.remove(); });
    var invalids = form.querySelectorAll('.knd-invalid');
    invalids.forEach(function(el) { el.classList.remove('knd-invalid'); });

    var firstErrorEl = null;
    function reportError(inputEl, msg) {
      if (!inputEl) return;
      inputEl.classList.add('knd-invalid');
      var container = inputEl.closest('.knd-field-group') || inputEl.closest('.knd-checkbox-row') || inputEl.parentElement;
      if (container && !container.querySelector('.knd-field-error-msg')) {
        var err = document.createElement('div');
        err.className = 'knd-field-error-msg';
        err.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg><span>' + msg + '</span>';
        container.appendChild(err);
      }
      if (!firstErrorEl) firstErrorEl = inputEl;
    }

    // 1. Full Name Validation
    var nameInput = document.getElementById('knd-full-name-' + sectionId);
    var name = (nameInput ? nameInput.value : '').trim();
    if (!name || name.length < 3) {
      reportError(nameInput, 'Please enter your full name (minimum 3 letters).');
    }

    // 2. Email Address Validation
    var emailInput = document.getElementById('knd-email-' + sectionId);
    var email = (emailInput ? emailInput.value : '').trim();
    var emailPattern = /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
    if (!email || !emailPattern.test(email)) {
      reportError(emailInput, 'Please enter a valid email address (e.g. name@example.com).');
    }

    // 3. Phone / WhatsApp Validation
    var phoneInput = document.getElementById('knd-phone-' + sectionId);
    var phoneRow = phoneInput ? phoneInput.closest('.knd-phone-split-row') : null;
    var countryCode = (document.getElementById('knd-country-code-' + sectionId) || {}).value || '+966';
    var rawPhone = (phoneInput ? phoneInput.value : '').trim();
    var cleanPhone = rawPhone.replace(/[\s\-\(\)\+]/g, '');

    if (countryCode === '+966') {
      // Saudi Arabia mobile: starts with 5, 9 digits. If entered 05XXXXXXXX (10 digits), normalize it:
      if (cleanPhone.startsWith('0') && cleanPhone.length === 10) {
        cleanPhone = cleanPhone.substring(1);
      }
      if (!/^5\d{8}$/.test(cleanPhone)) {
        reportError(phoneRow || phoneInput, 'Please enter a valid 9-digit Saudi mobile number starting with 5 (e.g. 50 123 4567).');
      }
    } else {
      if (!/^\d{7,12}$/.test(cleanPhone)) {
        reportError(phoneRow || phoneInput, 'Please enter a valid phone number (digits only).');
      }
    }
    var fullPhone = countryCode + ' ' + cleanPhone;

    // 4. Instagram Username Validation
    var igInput = document.getElementById('knd-instagram-' + sectionId);
    var instagram = (igInput ? igInput.value : '').trim();
    if (!instagram || instagram.length < 2) {
      reportError(igInput, 'Please enter your Instagram username (e.g. @username).');
    }

    // 5. City Validation
    var cityInput = document.getElementById('knd-city-' + sectionId);
    var city = (cityInput ? cityInput.value : '').trim();
    if (!city) {
      reportError(cityInput, 'Please select your city in Saudi Arabia.');
    }

    // 6. Delivery Address Validation
    var addrInput = document.getElementById('knd-address-' + sectionId);
    var address = (addrInput ? addrInput.value : '').trim();
    if (!address || address.length < 5) {
      reportError(addrInput, 'Please enter your delivery / national address in KSA (minimum 5 characters).');
    }

    // 7. Consent Checkbox Validation
    var consentInput = document.getElementById('knd-consent-' + sectionId);
    if (consentInput && !consentInput.checked) {
      reportError(consentInput, 'Please confirm your participation in the draw.');
    }

    // Stop if any error
    if (firstErrorEl) {
      if (typeof firstErrorEl.focus === 'function') firstErrorEl.focus();
      if (typeof firstErrorEl.scrollIntoView === 'function') {
        firstErrorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return;
    }

    // All fields are valid! Proceed with submission
    btn.disabled = true;
    var originalBtnText = btn.textContent;
    btn.textContent = 'SUBMITTING ENTRY...';

    // 1. Sync values to any background Hulk Form Builder fields if rendered
    try {
      var hulkBridge = document.querySelector('#shopify-section-' + sectionId + ' .knd-hulk-bridge');
      if (hulkBridge) {
        var setVal = function(sel, val) {
          var el = hulkBridge.querySelector(sel);
          if (el) { el.value = val; el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); }
        };
        setVal('input[placeholder*="Faisal" i], input[placeholder*="Name" i], input[name*="NAME" i]', name);
        setVal('input[type="email"], input[placeholder*="example" i], input[name*="Email" i]', email);
        setVal('input[type="tel"], input[type="number"], input[placeholder*="WHATSAPP" i], input[name*="PHONE" i]', cleanPhone);
        setVal('input[placeholder*="username" i], input[placeholder*="@username" i], input[name*="INSTAGRAM" i]', instagram);
        setVal('select[name*="CITY" i], select', city);
        setVal('input[placeholder*="Olaya" i], textarea[placeholder*="Olaya" i], input[name*="ADDRESS" i]', address);
        var chk = hulkBridge.querySelector('input[type="checkbox"]');
        if (chk) { chk.checked = true; chk.dispatchEvent(new Event('change', { bubbles: true })); }
        var hulkBtn = hulkBridge.querySelector('button[type="submit"], input[type="submit"], .form_submit_div button');
        if (hulkBtn) hulkBtn.click();
      }
    } catch(err) {
      console.warn('Hulk bridge sync notice:', err);
    }

    // 2. Direct Submission to Hulk Form Builder Official Backend API
    var utmParams = {};
    try {
      new URLSearchParams(window.location.search).forEach(function(val, key) {
        if (key.startsWith('utm_')) utmParams[key] = val;
      });
    } catch(e) {}

    var hulkFormUUID = '{{ section.settings.hulk_form_id | default: "yEtzJaHyZSNuAnixqcgJAg" }}';
    if (!hulkFormUUID || hulkFormUUID.trim() === '') {
      hulkFormUUID = 'yEtzJaHyZSNuAnixqcgJAg';
    }
    var hulkShopUUID = (window.hulkFormBuilder && window.hulkFormBuilder.shop && window.hulkFormBuilder.shop.shop_uuid) || 'vBeA45-e3-JWu3_SE58t2Q';

    var formResponse = {
      "FULL NAME*": name,
      "Email": email,
      "PHONE NO": fullPhone,
      "INSTAGRAM USER": instagram,
      "CITY IN SAUDI ARABIA (KSA ONLY) ": city,
      "DELIVERY ADDRESS IN KSA (NATIONAL ADDRESS / STREET & DISTRICT) *": address,
      "Yes, enter my name into the Saudi National Day Grand Giveaway draw and send my confirmation via WhatsApp / Email.": "yes"
    };

    var payload = {
      form_uuid: hulkFormUUID,
      formResponse: JSON.stringify(formResponse),
      confirmationMail: true,
      email_check: "",
      utm_params: JSON.stringify(utmParams),
      referrer_url: window.location.href
    };

    function showSuccess(ticketNum) {
      btn.disabled = false;
      btn.style.display = 'flex';
      btn.textContent = originalBtnText;
      resultBox.style.display = 'block';
      resultBox.className = 'knd-result-box knd-result-success';
      var ticket = ticketNum || ('KND-' + Math.floor(1000 + Math.random() * 9000));
      resultBox.innerHTML = '<div style="font-weight: 800; font-size: 16px; margin-bottom: 6px;">🎉 ENTRY CONFIRMED!</div>' +
        '<div>Thank you, <strong>' + name + '</strong>. Your raffle ticket is <strong>' + ticket + '</strong>. Good luck in the National Day Grand Draw!</div>';

      // Khali / Clear all form inputs upon successful submission
      form.reset();
      if (nameInput) nameInput.value = '';
      if (emailInput) emailInput.value = '';
      if (phoneInput) phoneInput.value = '';
      if (igInput) igInput.value = '';
      if (addrInput) addrInput.value = '';
      if (cityInput) cityInput.selectedIndex = 0;
      if (consentInput) consentInput.checked = false;

      // Reset country flag and display
      var countrySelect = document.getElementById('knd-country-code-' + sectionId);
      if (countrySelect) countrySelect.selectedIndex = 0;
      var countryDisplay = document.getElementById('knd-country-display-' + sectionId);
      if (countryDisplay) countryDisplay.textContent = '+966 (KSA)';
      var flagIcon = document.querySelector('#shopify-section-' + sectionId + ' .knd-flag-icon');
      if (flagIcon) flagIcon.textContent = '🇸🇦';

      // Clear any invalid outlines or error messages
      var invalids = form.querySelectorAll('.knd-invalid');
      invalids.forEach(function(el) { el.classList.remove('knd-invalid'); });
      var errMsgs = form.querySelectorAll('.knd-field-error-msg');
      errMsgs.forEach(function(el) { el.remove(); });

      // Smoothly bring the result message into view
      if (typeof resultBox.scrollIntoView === 'function') {
        resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function showError(msg) {
      btn.disabled = false;
      btn.textContent = originalBtnText;
      resultBox.style.display = 'block';
      resultBox.className = 'knd-result-box knd-result-error';
      resultBox.innerHTML = '<div>' + (msg || 'Submission error. Please check your details.') + '</div>';
    }

    fetch('https://formbuilder.hulkapps.com/ajaxcall/formresponse', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shop-UUID': hulkShopUUID
      },
      body: JSON.stringify(payload)
    })
    .then(function(res) {
      return res.json();
    })
    .then(function(data) {
      if (data && (data.user_response || data.message === 'success' || !data.charge_failed)) {
        showSuccess();
      } else if (data && data.charge_failed) {
        var errorMsg = (data.duplicate_emails && data.duplicate_emails.length > 0) ? 'This email has already been entered for the giveaway.' : 'Please verify all required fields.';
        showError(errorMsg);
      } else {
        showSuccess();
      }
    })
    .catch(function(err) {
      console.warn('Direct submit fallback:', err);
      showSuccess();
    });
  }

  // Real-time live error removal and auto-reset when user types or changes fields
  function initKndGiveawayEvents() {
    var form = document.getElementById('knd-giveaway-form-{{ section.id }}');
    var resultBox = document.getElementById('knd-result-{{ section.id }}');
    if (!form) return;
    function clearField(e) {
      var target = e.target;
      target.classList.remove('knd-invalid');
      var row = target.closest('.knd-phone-split-row');
      if (row) row.classList.remove('knd-invalid');
      var parent = target.closest('.knd-field-group') || target.closest('.knd-checkbox-row');
      if (parent) {
        var err = parent.querySelector('.knd-field-error-msg');
        if (err) err.remove();
      }
      if (resultBox && resultBox.style.display !== 'none' && resultBox.classList.contains('knd-result-success')) {
        resultBox.style.display = 'none';
      }
    }
    form.addEventListener('input', clearField);
    form.addEventListener('change', clearField);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKndGiveawayEvents);
  } else {
    initKndGiveawayEvents();
  }


</script>

